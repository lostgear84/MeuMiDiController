<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#C67B00"
                android:centerColor="#A76400"
                android:endColor="#714400"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#D99E32" />
        </shape>
    </item>

    <!-- Reflexo quase imperceptível quando o botão está pressionado -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="36dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient
                android:angle="270"
                android:startColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

</layer-list>