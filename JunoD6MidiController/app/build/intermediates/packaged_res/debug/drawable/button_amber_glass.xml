<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#F0A000"
                android:centerColor="#D88B00"
                android:endColor="#9D6200"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#F7C45A" />
        </shape>
    </item>

    <!-- Reflexo discreto: limitado ao topo e com transparência baixa -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="34dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient
                android:angle="270"
                android:startColor="#1FFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

</layer-list>