<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#3A2D0E"
                android:centerColor="#261D08"
                android:endColor="#151004"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#E0A633" />
        </shape>
    </item>

    <!-- Sem opacidade forte: somente sugestão de reflexo -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="36dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient
                android:angle="270"
                android:startColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

</layer-list>